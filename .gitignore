# Ignore backups from nested git repos
EKOAST.git.bak/
.vscode.git.bak/
sellers.for.ekoast.git.bak/
# Keep project folders
!EKOAST/
!.vscode/
!"sellers for ekoast/"

# Secrets and junk test files — never commit these
EKOAST/backend/serviceAccountKey.json
**/serviceAccountKey.json
**/*serviceAccount*.json
EKOAST/_tmp_test.txt

# Local tooling / deploy caches
.agent/
.firebase/
**/.firebase/
