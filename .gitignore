# Ignore backups from nested git repos
PAPERBAG.git.bak/
.vscode.git.bak/
sellers.for.paperbag.git.bak/
# Keep project folders
!PAPERBAG/
!.vscode/
!"sellers for paperbag/"

# Secrets and junk test files — never commit these
PAPERBAG/backend/serviceAccountKey.json
**/serviceAccountKey.json
**/*serviceAccount*.json
PAPERBAG/_tmp_test.txt

# Local tooling / deploy caches
.agent/
.firebase/
**/.firebase/
