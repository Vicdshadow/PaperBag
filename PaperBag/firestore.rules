rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPER FUNCTIONS ---
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRole(role) {
      return isAuthenticated() && (
        request.auth.token.role == role || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role
      );
    }

    function isAdmin() {
      return hasRole('admin') || 
             request.auth.token.email == "ekoast047@gmail.com" ||
             request.auth.token.email.matches(".*@ekoast.com$");
    }

    function isSeller() {
      return hasRole('seller');
    }

    // --- USERS ---
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId); // Restricted fields (role, status) should be handled by functions
      allow delete: if isAdmin();

      // --- WISHLIST (per-user) ---
      match /wishlist/{itemId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }
    }

    // --- PRODUCTS ---
    match /products/{productId} {
      allow read: if true;
      allow create: if isSeller() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == "active";
      allow update: if isAdmin() || (isSeller() && resource.data.uploadedBy == request.auth.uid);
      allow delete: if isAdmin();
    }

    // --- ORDERS ---
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.buyerId || 
        request.auth.uid == resource.data.sellerId || 
        isAdmin()
      );
      // Buyers create orders; payment status and totals are validated by Cloud Functions.
      allow create: if isAuthenticated();
      // Only admins may change order status directly. 
      // Payment and fulfillment transitions are handled by Cloud Functions.
      allow update: if isAdmin();
    }

    // --- WALLETS (STRICT SECURITY) ---
    match /wallets/{userId} {
      // Users can see their own balance, but NEVER update it from frontend
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false; // ONLY Cloud Functions (admin SDK) can update wallets
    }

    // --- TRANSACTIONS (AUDIT TRAIL) ---
    match /transactions/{transId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if false; // ONLY Cloud Functions can create/update transactions
    }

    // --- SELLER KYC ---
    match /sellerKyc/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isAdmin(); // Admin reviews and updates status
      allow delete: if isAdmin();
    }

    // --- SHIPPING SETTINGS ---
    match /shippingSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- CHAT SYSTEM ---
    match /conversations/{convId} {
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if isAuthenticated() && (request.auth.uid in request.resource.data.participants);
      allow update: if isAuthenticated() && (request.auth.uid in resource.data.participants || isAdmin());

      match /messages/{msgId} {
        allow read: if isAuthenticated() && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants || isAdmin());
        allow create: if isAuthenticated() && (
          isAdmin() ||
          (request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants &&
           request.resource.data.senderId == request.auth.uid)
        );
        allow update: if isAuthenticated() && (isAdmin() || resource.data.senderId == request.auth.uid);
      }
    }

    // --- NOTIFICATIONS ---
    match /notifications/{notifId} {
      allow read: if isOwner(resource.data.targetUid) || (resource.data.targetRole == 'admin' && isAdmin());
      allow write: if false; // Functions only
    }
  }
}
